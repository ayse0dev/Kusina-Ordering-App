# Rendered by entrypoint with envsubst: ${NGINX_RESOLVER}, ${REVERB_UPSTREAM}
server {
    listen 80 default_server;
    server_name _;

    # Only /public is ever web-accessible: .env, vendor/, storage/ and the app code are not reachable.
    root /var/www/html/public;
    index index.php;
    charset utf-8;

    # Never expose dotfiles (.env, .git, ...), except ACME-style /.well-known
    location ~ /\.(?!well-known) { deny all; }

    # Hashed build assets can be cached forever
    location ^~ /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Uploaded images: static files only, never executable (defence against web shells)
    location ^~ /storage/ {
        add_header X-Content-Type-Options nosniff;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'";
        location ~* \.(php|phtml|phar|pl|py|cgi|sh)$ { return 403; }
        try_files $uri =404;
    }

    # Live updates (Laravel Reverb). The browser connects to wss://your-domain/app/..., proxied to the reverb container.
    location /app {
        resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
        set $reverb_upstream http://${REVERB_UPSTREAM};
        proxy_pass $reverb_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # The ONLY PHP file that may run is index.php. Any other .php request (an uploaded or dropped file) is a 404.
    location = /index.php {
        fastcgi_pass 127.0.0.1:9000;
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 60s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
    location ~ \.php$ { return 404; }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }
}
