# =====================================================================
# Kusina: PRODUCTION settings.  cp .env.production.example .env.production
# .env.production is git-ignored. NEVER commit it or share it.
# =====================================================================

# ---- Your site ------------------------------------------------------
DOMAIN=kusina.example.com
APP_URL=https://kusina.example.com
APP_NAME="Kusina"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Edmonton
# Generate with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Behind Caddy: trust its forwarded headers (needed for https links and secure cookies)
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Database (MariaDB container). Use LONG random passwords. ------------
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kusina
DB_USERNAME=kusina
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Live updates (Reverb) -------------------------------------------
BROADCAST_CONNECTION=reverb
# Server side talks to the reverb container directly...
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# ...create these with:  openssl rand -hex 16   (app id: any number, e.g. 100001)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ---- Money ------------------------------------------------------------
KUSINA_TAX_RATE=0.05
KUSINA_TAX_LABEL="GST (5%)"
KUSINA_DELIVERY_FEE=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Restaurant details (shown on the Contact page / given to couriers) ----
KUSINA_ADDRESS="Your street address, Edson, Alberta"
KUSINA_PHONE=
KUSINA_EMAIL=

# ---- Delivery ---------------------------------------------------------
KUSINA_COURIER=manual
KUSINA_DISPATCH_ON=preparing
KUSINA_DELIVERY_MAX_KM=10
KUSINA_PICKUP_NAME=Kusina
KUSINA_PICKUP_ADDRESS=
KUSINA_PICKUP_PHONE=
KUSINA_PICKUP_LAT=
KUSINA_PICKUP_LNG=
KUSINA_GEOCODER=nominatim
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_SIGNING_KEY=
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_ENV=staging
GRAB_WEBHOOK_TOKEN=

# ---- Email (gift vouchers). The container blocks proc_open, so use SMTP or an API, NOT "sendmail". ----
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="hello@kusina.example.com"
MAIL_FROM_NAME="Kusina"
